    "fold.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The face check uses the outer camera. It's much sharper than the camera under this screen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตรวจใบหน้าใช้กล้องด้านนอก ซึ่งคมชัดกว่ากล้องใต้หน้าจอนี้มาก"
          }
